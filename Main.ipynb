import pandas as pd
import openai
from PyPDF2 import PdfReader
import os
from fpdf import FPDF

# 2. OpenAI Key - https://platform.openai.com/api-keys nunchi teesko
openai.api_key = "PASTE_YOUR_API_KEY_HERE"

# 3. Read Job Description
with open('job_description.txt', 'r', encoding='utf-8') as f:
    jd = f.read()

# 4. Extract text from PDF resumes
def extract_text_from_pdf(pdf_path):
    reader = PdfReader(pdf_path)
    text = ""
    for page in reader.pages:
        text += page.extract_text()
    return text

# 5. Get AI score using GPT-3.5
def get_match_score(resume_text, jd_text):
    prompt = f"""
    You are an HR expert. Analyze this resume against the Job Description.
    
    Job Description: {jd_text}
    Candidate Resume: {resume_text}
    
    Give output in this exact format:
    Score: XX/100 | Skills Match: XX% | Experience: XX% | Education: XX% | Reason: One line
    """
    response = openai.ChatCompletion.create(
        model="gpt-3.5-turbo",
        messages=[{"role": "user", "content": prompt}]
    )
    return response.choices[0].message.content

# 6. Process all resumes in 'resumes' folder
results = []
for file in os.listdir('resumes'):
    if file.endswith('.pdf'):
        print(f"Processing {file}...")
        resume_text = extract_text_from_pdf(f'resumes/{file}')
        score_data = get_match_score(resume_text, jd)
        results.append({'Candidate_File': file, 'AI_Analysis': score_data})

# 7. Create Ranked Output PDF for submission
df = pd.DataFrame(results)
pdf = FPDF()
pdf.add_page()
pdf.set_font("Arial", size=10)
pdf.cell(200, 10, txt="INDIA.RUNS - Ranked Candidate Output", ln=1, align='C')
for index, row in df.iterrows():
    pdf.multi_cell(0, 8, txt=f"{row['Candidate_File']}: {row['AI_Analysis']}", border=1)
pdf.output("ranked_output.pdf")
print("Done! ranked_output.pdf is ready for submission")
